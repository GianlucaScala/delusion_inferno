; Engine configuration file.
config_version=5

[application]

config/name="iNFERNO;"
config/use_custom_user_dir=true
config/custom_user_dir_name="inferno"
config/description="Third-Person-Shooter-RPG. Abstieg durch eine verfallene Megastruktur."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.15, 0.18, 0.205, 1)
